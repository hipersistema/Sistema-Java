(Activa o No Activa)]]></fieldDescription>
	</field>
	<field name="Location" class="java.lang.String"/>
	<variable name="promotionStatus" class="java.lang.Integer">
		<variableExpression><![CDATA[$V{promotionStatus}.valueOf($F{promotionStatus})]]></variableExpression>
	</variable>
	<variable name="SalePrice" class="java.lang.Double">
		<variableExpression><![CDATA[$V{SalePrice}.valueOf($F{saleprice})]]></variableExpression>
	</variable>
	<variable name="PromotionItemPrice" class="java.lang.Double">
		<variableExpression><![CDATA[$V{PromotionItemPrice}.valueOf($F{promotionItemPrice})]]></variableExpression>
	</variable>
	<variable name="PVP" class="java.lang.Double">
		<variableExpression><![CDATA[$V{SalePrice} / (1 +
    (RedondeoBsS.ivaValor($F{taxID}.substring(0,1)) / 100.00)
)]]></variableExpression>
	</variable>
	<variable name="IVA" class="java.lang.Double">
		<variableExpression><![CDATA[$V{SalePrice} - $V{PVP}]]></variableExpression>
	</variable>
	<variable name="PromoPrecio" class="java.lang.Double">
		<variableExpression><![CDATA[$V{PromotionItemPrice} / (1 +
    (RedondeoBsS.ivaValor($F{taxID}.substring(0,1)) / 100.00)
)]]></variableExpression>
	</variable>
	<variable name="IVAPROMO" class="java.lang.Double">
		<variableExpression><![CDATA[$V{PromotionItemPrice} - $V{PromoPrecio}]]></variableExpression>
	</variable>
	<variable name="IvaEtiqueta" class="java.lang.String">
		<variableExpression><![CDATA[RedondeoBsS.ivaTextoIndex($F{taxID}.substring(0,1))]]></variableExpression>
	</variable>
