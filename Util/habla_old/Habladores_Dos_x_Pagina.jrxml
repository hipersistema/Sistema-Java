	<variable name="articulo" class="java.lang.String">
		<variableExpression><![CDATA[//$F{itemID}.length()<13?"1000000" + $F{itemID}:$F{itemID}.substring(0,12)
$F{itemID}.length()<13?$F{itemID}.length()==5?"1000000" + $F{itemID}
