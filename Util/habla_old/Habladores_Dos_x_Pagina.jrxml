:$F{itemID}.length()==2?"1000000000" + $F{itemID}
:$F{itemID}.length()==11?"1" + $F{itemID}:$F{itemID}
:$F{itemID}.substring(0,12)]]></variableExpression>
	</variable>
	<variable name="PVP" class="java.lang.Double">
		<variableExpression><![CDATA[($F{taxID}.substring(0,1).trim().equals("1") ? $V{SalePrice}/1.12 :
($F{taxID}.substring(0,1).trim().equals("2") ? $V{SalePrice}/1.08 :
($F{taxID}.substring(0,1).trim().equals("3") ? $V{SalePrice}/1.22 : $V{SalePrice} ) ) )]]></variableExpression>
	</variable>
	<variable name="IVA" class="java.lang.Double">
		<variableExpression><![CDATA[$V{SalePrice} - $V{PVP}]]></variableExpression>
	</variable>
	<variable name="PromoPrecio" class="java.lang.Double">
		<variableExpression><![CDATA[($F{taxID}.substring(0,1).trim().equals("1") ? $V{PromotionItemPrice}/1.12 :
($F{taxID}.substring(0,1).trim().equals("2") ? $V{PromotionItemPrice}/1.08 :
($F{taxID}.substring(0,1).trim().equals("3") ? $V{PromotionItemPrice}/1.22 : $V{PromotionItemPrice} ) ) )]]></variableExpression>
	</variable>
	<variable name="IVAPROMO" class="java.lang.Double">
		<variableExpression><![CDATA[$V{PromotionItemPrice} - $V{PromoPrecio}]]></variableExpression>
	</variable>
